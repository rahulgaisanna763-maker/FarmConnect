rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isFarmer() { return signedIn() && userDoc().role == 'farmer'; }
    function isAdmin() { return signedIn() && userDoc().role == 'admin'; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['buyer','farmer'];
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if isFarmer() && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isFarmer() && resource.data.farmerId == request.auth.uid);
    }
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid ||
        resource.data.items.size() > 0 || isAdmin());
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'requested';
      allow update: if signedIn() && (isAdmin() ||
        resource.data.buyerId == request.auth.uid);
    }
  }
}