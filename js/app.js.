const $=s=>document.querySelector(s), money=n=>"₹"+Number(n).toLocaleString("en-IN"), esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const farmerSeed=[
{id:"farmer1",name:"Ravi Kumar",farm:"Green Valley Farm",location:"Karimnagar",role:"farmer"},
{id:"farmer2",name:"Lakshmi Devi",farm:"Lakshmi Organics",location:"Warangal",role:"farmer"},
{id:"farmer3",name:"Suresh Reddy",farm:"Sunrise Fields",location:"Siddipet",role:"farmer"},
{id:"farmer4",name:"Anitha Rao",farm:"Anitha Fresh Produce",location:"Jagtial",role:"farmer"},
{id:"farmer5",name:"Mahesh Goud",farm:"Harvest Basket",location:"Peddapalli",role:"farmer"}];
const seedRows=[
["Tomatoes","Vegetables","🍅",32,"kg","Karimnagar","farmer1",85],["Spinach","Vegetables","🥬",24,"bunch","Warangal","farmer2",40],["Carrots","Vegetables","🥕",45,"kg","Siddipet","farmer3",60],["Green Chillies","Vegetables","🌶️",55,"kg","Jagtial","farmer4",35],["Cauliflower","Vegetables","🥦",38,"piece","Peddapalli","farmer5",50],
["Mangoes","Fruits","🥭",90,"kg","Karimnagar","farmer1",120],["Bananas","Fruits","🍌",48,"dozen","Warangal","farmer2",65],["Papaya","Fruits","🍈",35,"kg","Siddipet","farmer3",45],["Guava","Fruits","🍐",60,"kg","Jagtial","farmer4",30],["Watermelon","Fruits","🍉",28,"kg","Peddapalli","farmer5",100],
["Sona Masoori Rice","Grains","🌾",58,"kg","Karimnagar","farmer1",300],["Wheat","Grains","🌾",42,"kg","Warangal","farmer2",180],["Toor Dal","Grains","🫘",115,"kg","Siddipet","farmer3",90],["Groundnuts","Grains","🥜",95,"kg","Jagtial","farmer4",75],["Fresh Milk","Dairy","🥛",56,"litre","Peddapalli","farmer5",40]];
const seededProducts=seedRows.map((r,i)=>({id:"p"+(i+1),name:r[0],category:r[1],emoji:r[2],price:r[3],unit:r[4],location:r[5],farmerId:r[6],quantity:r[7],availableDate:new Date().toISOString().slice(0,10),fulfilment:"Pickup and delivery by arrangement",active:true,description:"Fresh produce directly from a local farm."}));
let db=null,auth=null,cloud=false,user=null,products=[],orders=[],farmers=farmerSeed,cart=JSON.parse(localStorage.getItem("fc_cart")||"[]");
const demo=()=>!window.FARMCONNECT_FIREBASE_CONFIG?.apiKey;
function toast(s){let t=$("#toast");t.textContent=s;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),2300)}
function persist(){localStorage.setItem("fc_products",JSON.stringify(products));localStorage.setItem("fc_orders",JSON.stringify(orders))}
function loadDemo(){products=JSON.parse(localStorage.getItem("fc_products")||"null")||seededProducts;orders=JSON.parse(localStorage.getItem("fc_orders")||"[]");user=JSON.parse(sessionStorage.getItem("fc_user")||"null");persist()}
async function init(){
 if(!demo()&&window.firebase){try{firebase.initializeApp(FARMCONNECT_FIREBASE_CONFIG);auth=firebase.auth();db=firebase.firestore();cloud=true;auth.onAuthStateChanged(async u=>{user=u?await getProfile(u):null;await refresh();renderAll()})}catch(e){console.error(e);toast("Firebase unavailable; local demo mode enabled");loadDemo()}}else loadDemo();
 document.querySelectorAll(".nav").forEach(b=>b.onclick=()=>showPage(b.dataset.page));
 $("#auth-button").onclick=()=>user?signOut():authModal();
 ["search-input","category-filter","location-filter","availability-filter"].forEach(id=>$("#"+id).addEventListener(id==="search-input"?"input":"change",renderMarket));
 $("#price-filter").oninput=e=>{$("#price-value").textContent=e.target.value;renderMarket()};
 $("#add-product-button").onclick=()=>productModal();$("#place-order").onclick=placeOrder;
 await refresh();renderAll();
}
async function getProfile(u){let d=await db.collection("users").doc(u.uid).get();return d.exists?{uid:u.uid,...d.data()}:{uid:u.uid,name:u.email,role:"buyer"}}
async function refresh(){if(!cloud)return;try{let [p,o,f]=await Promise.all([db.collection("products").get(),db.collection("orders").get(),db.collection("users").get()]);products=p.docs.map(x=>({id:x.id,...x.data()}));orders=o.docs.map(x=>({id:x.id,...x.data()}));let fs=f.docs.map(x=>({id:x.id,...x.data()})).filter(x=>x.role==="farmer");farmers=fs.length?fs:farmerSeed}catch(e){console.error(e);toast("Could not refresh cloud data")}}
function farmer(id){return farmers.find(f=>f.id===id)||{name:"Local farmer",farm:"Independent farm",location:"Local"}}
function showPage(p){document.querySelectorAll(".page").forEach(x=>x.classList.add("hidden"));$("#"+p+"-page").classList.remove("hidden");document.querySelectorAll(".nav").forEach(x=>x.classList.toggle("active",x.dataset.page===p));if(p==="dashboard")renderDashboard();if(p==="cart")renderCart();scrollTo({top:0,behavior:"smooth"})}
function renderAll(){renderMarket();renderDashboard();renderCart();$("#user-label").textContent=user?`${user.name} · ${user.role}`:"Guest buyer";$("#auth-button").textContent=user?"Sign out":"Sign in";$("#cart-count").textContent=cart.reduce((a,x)=>a+x.qty,0);let locations=[...new Set(products.map(p=>p.location))].sort();let old=$("#location-filter").value;$("#location-filter").innerHTML='<option value="">All locations</option>'+locations.map(x=>`<option>${esc(x)}</option>`).join("");$("#location-filter").value=old}
function renderMarket(){if(!$("#market-grid"))return;let q=$("#search-input").value.toLowerCase(),cat=$("#category-filter").value,loc=$("#location-filter").value,max=+$("#price-filter").value;let list=products.filter(p=>p.active!==false&&p.quantity>0&&p.price<=max&&(!cat||p.category===cat)&&(!loc||p.location===loc)&&(!q||`${p.name} ${p.category} ${p.location} ${farmer(p.farmerId).name}`.toLowerCase().includes(q)));$("#result-count").textContent=`${list.length} products found`;$("#market-grid").innerHTML=list.length?list.map(p=>`<article class="product-card"><div class="product-image"><span class="tag">${esc(p.category)}</span>${esc(p.emoji||"🌱")}</div><div class="product-info"><h3>${esc(p.name)}</h3><div class="farm">${esc(farmer(p.farmerId).farm)} · ${esc(p.location)}</div><div class="product-meta"><span>Stock: ${p.quantity} ${esc(p.unit)}</span><span>📍 ${esc(p.location)}</span></div><div class="product-meta"><span class="product-price">${money(p.price)} <small>/ ${esc(p.unit)}</small></span><span>Farm direct</span></div><button class="add-btn" onclick="addCart('${p.id}')">＋ Add to basket</button></div></article>`).join(""):'<div class="empty" style="grid-column:1/-1"><b>🌱</b>No produce matches those filters.</div>'}
function addCart(id){let p=products.find(x=>x.id===id),c=cart.find(x=>x.productId===id);if(!p)return;if(c){if(c.qty>=p.quantity)return toast("Available stock limit reached.");c.qty++}else cart.push({productId:id,qty:1});localStorage.setItem("fc_cart",JSON.stringify(cart));$("#cart-count").textContent=cart.reduce((a,x)=>a+x.qty,0);toast("Added to basket")}
function renderCart(){let items=cart.map(c=>({...c,p:products.find(p=>p.id===c.productId)})).filter(x=>x.p),total=items.reduce((a,x)=>a+x.qty*x.p.price,0);$("#cart-items").innerHTML=items.length?items.map(x=>`<div class="cart-row"><div class="cart-emoji">${esc(x.p.emoji)}</div><div><h4>${esc(x.p.name)}</h4><small>${money(x.p.price)} / ${esc(x.p.unit)} · ${esc(x.p.location)}</small></div><div class="qty"><button onclick="changeQty('${x.productId}',-1)">−</button><b>${x.qty}</b><button onclick="changeQty('${x.productId}',1)">+</button></div><button class="remove" onclick="removeCart('${x.productId}')">Remove</button></div>`).join(""):'<div class="empty"><b>🧺</b>Your basket is empty.</div>';$("#cart-subtotal").textContent=money(total);$("#cart-total").textContent=money(total);$("#place-order").disabled=!items.length}
function changeQty(id,d){let c=cart.find(x=>x.productId===id),p=products.find(x=>x.id===id);if(!c)return;if(d>0&&c.qty>=p.quantity)return toast("Available stock limit reached.");c.qty+=d;if(c.qty<=0)removeCart(id);else{localStorage.setItem("fc_cart",JSON.stringify(cart));renderCart();$("#cart-count").textContent=cart.reduce((a,x)=>a+x.qty,0)}}
function removeCart(id){cart=cart.filter(x=>x.productId!==id);localStorage.setItem("fc_cart",JSON.stringify(cart));renderCart();$("#cart-count").textContent=cart.reduce((a,x)=>a+x.qty,0)}
async function placeOrder(){if(!user){toast("Sign in as a buyer to order");return authModal()}if(user.role!=="buyer")return toast("Use a buyer account to place an order.");let lines=cart.map(c=>({...c,p:products.find(p=>p.id===c.productId)})).filter(x=>x.p);if(!lines.length)return;for(let x of lines)if(x.qty>x.p.quantity)return toast(`Only ${x.p.quantity} ${x.p.unit} available for ${x.p.name}.`);let order={id:"ord"+Date.now(),buyerId:user.uid||user.id,buyerName:user.name,items:lines.map(x=>({productId:x.productId,name:x.p.name,farmerId:x.p.farmerId,qty:x.qty,unit:x.p.unit,price:x.p.price})),total:lines.reduce((a,x)=>a+x.qty*x.p.price,0),fulfilment:$("#fulfilment").value,note:$("#order-note").value,status:"requested",createdAt:new Date().toISOString()};try{if(cloud){let batch=db.batch();for(let x of lines)batch.update(db.collection("products").doc(x.productId),{quantity:firebase.firestore.FieldValue.increment(-x.qty)});batch.set(db.collection("orders").doc(order.id),order);await batch.commit()}else{lines.forEach(x=>{products.find(p=>p.id===x.productId).quantity-=x.qty});orders.unshift(order);persist()}cart=[];localStorage.setItem("fc_cart","[]");await refresh();renderAll();toast("Order request sent");showPage("dashboard")}catch(e){console.error(e);toast("Order failed; stock may have changed. Refresh and retry.")}}
function metric(label,value){return `<div class="metric"><span>${label}</span><b>${value}</b></div>`}
function productTable(list,admin=false){return list.length?`<h3>Produce listings</h3><table class="data-table"><thead><tr><th>Product</th><th>Location</th><th>Stock</th><th>Price</th><th>Action</th></tr></thead><tbody>${list.map(p=>`<tr><td>${esc(p.emoji)} ${esc(p.name)}</td><td>${esc(p.location)}</td><td>${p.quantity} ${esc(p.unit)}</td><td>${money(p.price)} / ${esc(p.unit)}</td><td>${admin?`<button class="table-action" onclick="moderate('${p.id}')">${p.active===false?"Restore":"Hide"}</button>`:`<button class="table-action" onclick="productModal('${p.id}')">Edit</button><button class="table-action" onclick="deleteProduct('${p.id}')">Delete</button>`}</td></tr>`).join("")}</tbody></table>`:'<div class="empty">No listings yet.</div>'}
function orderTable(list,canUpdate){return `<h3>Orders</h3>${list.length?`<table class="data-table"><thead><tr><th>Order</th><th>Buyer</th><th>Items</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody>${list.map(o=>`<tr><td>${esc(o.id.slice(-7))}</td><td>${esc(o.buyerName||"Buyer")}</td><td>${o.items.map(i=>`${esc(i.name)} × ${i.qty}`).join(", ")}</td><td>${money(o.total)}</td><td><span class="status ${o.status}">${esc(o.status)}</span></td><td>${canUpdate?`<select onchange="updateStatus('${o.id}',this.value)">${["requested","accepted","ready","completed","cancelled"].map(s=>`<option ${o.status===s?"selected":""}>${s}</option>`).join("")}</select>`:"—"}</td></tr>`).join("")}</tbody></table>`:'<div class="empty">No orders yet.</div>'}`}
function renderDashboard(){let role=user?.role||"guest",id=user?.uid||user?.id,mine=orders.filter(o=>role==="admin"||o.buyerId===id||o.items?.some(i=>i.farmerId===id));if(role==="farmer"){let own=products.filter(p=>p.farmerId===id);$("#dashboard-title").textContent="Farmer dashboard";$("#dashboard-subtitle").textContent="Manage produce, stock and incoming orders.";$("#add-product-button").classList.remove("hidden");$("#dashboard-list-title").textContent="Inventory & incoming orders";$("#metrics").innerHTML=metric("Active listings",own.filter(p=>p.active!==false).length)+metric("Incoming orders",mine.length)+metric("Units in stock",own.reduce((a,p)=>a+p.quantity,0))+metric("Completed sales",money(mine.filter(o=>o.status==="completed").reduce((a,o)=>a+o.total,0)));$("#dashboard-content").innerHTML=productTable(own)+orderTable(mine,true)}
else if(role==="admin"){$("#dashboard-title").textContent="Admin moderation";$("#dashboard-subtitle").textContent="Review listings and maintain marketplace quality.";$("#add-product-button").classList.add("hidden");$("#dashboard-list-title").textContent="All listings and orders";$("#metrics").innerHTML=metric("Listings",products.length)+metric("Farmers",farmers.length)+metric("Orders",orders.length)+metric("Pending",orders.filter(o=>o.status==="requested").length);$("#dashboard-content").innerHTML=productTable(products,true)+orderTable(orders,true)}
else{$("#dashboard-title").textContent="Buyer dashboard";$("#dashboard-subtitle").textContent=user?"Track order requests and purchases.":"Sign in to view order history, or explore the demo marketplace.";$("#add-product-button").classList.add("hidden");$("#dashboard-list-title").textContent="Your order history";$("#metrics").innerHTML=metric("Orders",mine.length)+metric("Awaiting response",mine.filter(o=>o.status==="requested").length)+metric("Completed",mine.filter(o=>o.status==="completed").length)+metric("Order value",money(mine.reduce((a,o)=>a+o.total,0)));$("#dashboard-content").innerHTML=orderTable(mine,false)}}
function modal(html){$("#modal-root").innerHTML=`<div class="modal-backdrop" onclick="if(event.target===this)closeModal()"><div class="modal">${html}</div></div>`}
function closeModal(){$("#modal-root").innerHTML=""}
function authModal(){modal(`<button class="close" onclick="closeModal()">×</button><h2>Welcome to FarmConnect</h2><form id="auth-form"><label>Full name</label><input name="name" required placeholder="Your name"><label>Email</label><input name="email" type="email" required placeholder="you@example.com"><label>Password</label><input name="password" type="password" minlength="6" required placeholder="At least 6 characters"><label>Account type</label><select name="role"><option value="buyer">Buyer</option><option value="farmer">Farmer</option><option value="admin">Admin (demo moderation)</option></select><label>Farm / location (farmers)</label><input name="location" placeholder="e.g. Karimnagar"><button class="btn primary">Create account / Sign in</button></form><p class="muted">Demo mode uses a temporary browser session. Firebase mode uses email/password authentication. Admin role assignment should be restricted by an actual production administrator.</p>`);$("#auth-form").onsubmit=async e=>{e.preventDefault();let d=Object.fromEntries(new FormData(e.target));try{if(cloud){let cred;try{cred=await auth.signInWithEmailAndPassword(d.email,d.password)}catch(err){if(err.code!=="auth/user-not-found"&&err.code!=="auth/invalid-credential")throw err;cred=await auth.createUserWithEmailAndPassword(d.email,d.password)}let ref=db.collection("users").doc(cred.user.uid),snap=await ref.get();if(!snap.exists)await ref.set({name:d.name,email:d.email,role:d.role,location:d.location||"",farm:d.role==="farmer"?d.name+"'s Farm":""});user=await getProfile(cred.user)}else{user={id:"demo_"+Date.now(),uid:"demo_"+Date.now(),name:d.name,email:d.email,role:d.role,location:d.location||"",farm:d.role==="farmer"?d.name+"'s Farm":""};sessionStorage.setItem("fc_user",JSON.stringify(user));if(d.role==="farmer"&&!farmers.some(f=>f.id===user.id)){farmers.push({...user,id:user.id});products=products.concat([]);persist()}}closeModal();await refresh();renderAll();toast("Signed in successfully")}catch(err){console.error(err);toast(err.message||"Authentication failed")}}}
function signOut(){if(cloud)auth.signOut();else{user=null;sessionStorage.removeItem("fc_user")}renderAll();toast("Signed out")}
function productModal(id){if(!user||!["farmer","admin"].includes(user.role))return toast("Sign in with a farmer account to list produce.");let p=products.find(x=>x.id===id);modal(`<button class="close" onclick="closeModal()">×</button><h2>${p?"Edit listing":"Add produce listing"}</h2><form id="product-form"><div class="form-grid"><div><label>Product name</label><input name="name" required value="${esc(p?.name||"")}"></div><div><label>Category</label><select name="category">${["Vegetables","Fruits","Grains","Dairy","Other"].map(x=>`<option ${p?.category===x?"selected":""}>${x}</option>`).join("")}</select></div><div><label>Emoji / photo symbol</label><input name="emoji" value="${esc(p?.emoji||"🌱")}"></div><div><label>Unit</label><select name="unit">${["kg","gram","bunch","piece","dozen","litre","quintal"].map(x=>`<option ${p?.unit===x?"selected":""}>${x}</option>`).join("")}</select></div><div><label>Price (₹ per unit)</label><input name="price" type="number" min="1" required value="${p?.price||""}"></div><div><label>Available quantity</label><input name="quantity" type="number" min="0" required value="${p?.quantity??""}"></div><div><label>Location</label><input name="location" required value="${esc(p?.location||user.location||"")}"></div><div><label>Availability date</label><input name="availableDate" type="date" required value="${p?.availableDate||new Date().toISOString().slice(0,10)}"></div></div><label>Pickup / delivery option</label><select name="fulfilment"><option>Pickup and delivery by arrangement</option><option>Pickup only</option></select><label>Description</label><textarea name="description">${esc(p?.description||"Fresh produce directly from our farm.")}</textarea><button class="btn primary">Save listing</button></form>`);$("#product-form").onsubmit=async e=>{e.preventDefault();let d=Object.fromEntries(new FormData(e.target)),item={...p,...d,id:p?.id||"p"+Date.now(),farmerId:p?.farmerId||user.uid||user.id,price:+d.price,quantity:+d.quantity,active:true};try{if(cloud)await db.collection("products").doc(item.id).set(item);else{let i=products.findIndex(x=>x.id===item.id);if(i<0)products.push(item);else products[i]=item;persist()}closeModal();await refresh();renderAll();toast("Listing saved")}catch(err){toast("Could not save listing")}}}
async function deleteProduct(id){if(!confirm("Hide this listing from the marketplace?"))return;await setActive(id,false)}
async function moderate(id){let p=products.find(x=>x.id===id);await setActive(id,p.active===false)}
async function setActive(id,active){if(cloud)await db.collection("products").doc(id).update({active});else{let p=products.find(x=>x.id===id);if(p)p.active=active;persist()}await refresh();renderAll();toast("Listing updated")}
async function updateStatus(id,status){let o=orders.find(x=>x.id===id);if(!o||["completed","cancelled"].includes(o.status))return toast("This order is already closed.");try{if(status==="cancelled"){if(cloud){let batch=db.batch();for(let i of o.items)batch.update(db.collection("products").doc(i.productId),{quantity:firebase.firestore.FieldValue.increment(i.qty)});batch.update(db.collection("orders").doc(id),{status});await batch.commit()}else{o.items.forEach(i=>{let p=products.find(p=>p.id===i.productId);if(p)p.quantity+=i.qty});o.status=status;persist()}}else if(cloud)await db.collection("orders").doc(id).update({status});else{o.status=status;persist()}await refresh();renderAll();toast("Order status updated")}catch(e){console.error(e);toast("Could not update order status")}}
document.addEventListener("DOMContentLoaded",init);
